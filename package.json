{
  "name": "urumap",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive maps of Uruguayan public buildings, rendered from mapcreator JSON.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-map-index.mjs && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "index": "node scripts/build-map-index.mjs",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^17.0.0",
    "prettier": "^3.3.0",
    "vite": "^5.1.6"
  }
}
